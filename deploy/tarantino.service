[Unit]
Description=tarantino home cinema
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tarantino
Group=tarantino
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/tarantino/tarantino.env
Environment=TARANTINO_DATA_DIR=/var/lib/tarantino
Environment=TARANTINO_FRONTEND_DIR=@APP_DIR@/frontend/build
Environment=HOME=/var/lib/tarantino
ExecStart=@APP_DIR@/.venv/bin/uvicorn tarantino.main:app --host 127.0.0.1 --port 8000 --no-access-log --timeout-graceful-shutdown 5
Restart=always
RestartSec=3

# Local only: the host's reverse proxy serves port 80 and forwards to this port.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tarantino

[Install]
WantedBy=multi-user.target
