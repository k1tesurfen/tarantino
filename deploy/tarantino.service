[Unit]
Description=tarantino home cinema
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tarantino
Group=tarantino
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/tarantino/tarantino.env
Environment=TARANTINO_DATA_DIR=/var/lib/tarantino
Environment=TARANTINO_FRONTEND_DIR=@APP_DIR@/frontend/build
Environment=HOME=/var/lib/tarantino
ExecStart=@APP_DIR@/.venv/bin/uvicorn tarantino.main:app --host 0.0.0.0 --port 80 --no-access-log
Restart=always
RestartSec=3

# Bind port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tarantino

[Install]
WantedBy=multi-user.target
