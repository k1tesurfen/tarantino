# tarantino secrets — copy to /etc/tarantino/tarantino.env (done by install.sh)
# Only secrets and deployment paths belong here. Everything else is configured
# in the admin website and is part of the config export.

# Jellyfin (Dashboard -> API Keys). The server URL defaults to http://localhost:8096.
TARANTINO_JELLYFIN_API_KEY=
TARANTINO_JELLYFIN_USER=
# TARANTINO_JELLYFIN_URL=http://localhost:8096

# Password for the admin website.
TARANTINO_ADMIN_PASSWORD=

# Home Assistant long-lived access token (the HA URL is an admin setting).
TARANTINO_HA_TOKEN=

# Log level for the journal: DEBUG, INFO (default), WARNING or ERROR.
# TARANTINO_LOG_LEVEL=INFO
